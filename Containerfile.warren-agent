FROM docker.io/library/node:24-bookworm-slim

ARG GH_VERSION=2.80.0
ARG PI_VERSION=0.85.1
ARG SEEDS_VERSION=0.5.12
ARG MULCH_VERSION=0.10.7
ARG BUN_VERSION=1.3.13
ARG TRELLIS_COMMIT=fd3bbadf1fa92c3b15e72836689b30094f4f534a

RUN apt-get update \
  && apt-get install --no-install-recommends -y ca-certificates curl git jq tar unzip \
  && rm -rf /var/lib/apt/lists/* \
  && arch="$(dpkg --print-architecture)" \
  && case "$arch" in \
       amd64) gh_arch=amd64; bun_arch=x64 ;; \
       arm64) gh_arch=arm64; bun_arch=aarch64 ;; \
       *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
     esac \
  && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" | tar -xz --strip-components=2 -C /usr/local/bin "gh_${GH_VERSION}_linux_${gh_arch}/bin/gh" \
  && curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${bun_arch}.zip" -o /tmp/bun.zip \
  && unzip -q /tmp/bun.zip -d /tmp/bun \
  && install -m 0755 "/tmp/bun/bun-linux-${bun_arch}/bun" /usr/local/bin/bun \
  && rm -rf /tmp/bun /tmp/bun.zip \
  && npm install --global \
       "@earendil-works/pi-coding-agent@${PI_VERSION}" \
       "@os-eco/seeds-cli@${SEEDS_VERSION}" \
       "@os-eco/mulch-cli@${MULCH_VERSION}" \
  && git clone --quiet https://github.com/jayminwest/trellis.git /opt/trellis \
  && git -C /opt/trellis checkout --quiet "${TRELLIS_COMMIT}" \
  && bun install --cwd /opt/trellis --frozen-lockfile \
  && printf '#!/bin/sh\nexec bun /opt/trellis/src/cli/main.ts "$@"\n' > /usr/local/bin/trellis \
  && chmod 0755 /usr/local/bin/trellis \
  && rm -rf /opt/trellis/.git \
  && git config --system advice.detachedHead false \
  && apt-get clean

RUN sd --version && ml --version && trellis --help >/dev/null

ENV HOME=/workspace \
    PI_CODING_AGENT_HOME=/workspace/.pi \
    PATH=/usr/local/bin:$PATH

WORKDIR /workspace
ENTRYPOINT ["pi"]
