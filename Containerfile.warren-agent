FROM docker.io/library/node:24-bookworm-slim

ARG GH_VERSION=2.80.0
ARG PI_VERSION=0.85.1
ARG BUN_VERSION=1.3.13
ARG SEEDS_VERSION=0.5.15
ARG MULCH_VERSION=0.10.7
ARG TRELLIS_VERSION=1.0.1
ARG TERRARIUM_COMMIT=afeec9cc0b7e6e7f4315647e4556afe42e140897
ARG TERRARIUM_SHA256=8e35c503b47857662a749f3dac634fe491f1afe1c4ed30a286ab372f6d524fb1

RUN apt-get update \
  && apt-get install --no-install-recommends -y ca-certificates curl git jq tar \
  && rm -rf /var/lib/apt/lists/* \
  && arch="$(dpkg --print-architecture)" \
  && case "$arch" in amd64) gh_arch=amd64 ;; arm64) gh_arch=arm64 ;; *) echo "unsupported architecture: $arch" >&2; exit 1 ;; esac \
  && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" | tar -xz --strip-components=2 -C /usr/local/bin "gh_${GH_VERSION}_linux_${gh_arch}/bin/gh" \
  && npm install --global \
    "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    "bun@${BUN_VERSION}" \
    "@os-eco/seeds-cli@${SEEDS_VERSION}" \
    "@os-eco/mulch-cli@${MULCH_VERSION}" \
    "trellis-cli@${TRELLIS_VERSION}" \
  && mkdir -p /opt/terrarium \
  && curl -fsSL "https://github.com/RogerNavelsaker/terrarium/archive/${TERRARIUM_COMMIT}.tar.gz" -o /tmp/terrarium.tar.gz \
  && printf '%s  %s\n' "${TERRARIUM_SHA256}" /tmp/terrarium.tar.gz | sha256sum -c - \
  && tar -xzf /tmp/terrarium.tar.gz --strip-components=1 -C /opt/terrarium \
  && cd /opt/terrarium \
  && npm install --omit=dev \
  && printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/bun /opt/terrarium/src/index.ts "$@"' > /usr/local/bin/terrarium \
  && printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/bun /opt/terrarium/src/index.ts "$@"' > /usr/local/bin/tr \
  && chmod 755 /usr/local/bin/terrarium /usr/local/bin/tr \
  && rm -f /tmp/terrarium.tar.gz \
  && git config --system advice.detachedHead false \
  && apt-get clean

ENV HOME=/workspace \
    PI_CODING_AGENT_HOME=/workspace/.pi \
    PATH=/usr/local/bin:$PATH

WORKDIR /workspace
ENTRYPOINT ["pi"]
