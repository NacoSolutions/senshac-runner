FROM docker.io/library/node:24-bookworm-slim

ARG GH_VERSION=2.80.0
ARG PI_VERSION=0.85.1

RUN apt-get update \
  && apt-get install --no-install-recommends -y ca-certificates curl git jq tar \
  && rm -rf /var/lib/apt/lists/* \
  && arch="$(dpkg --print-architecture)" \
  && case "$arch" in amd64) gh_arch=amd64 ;; arm64) gh_arch=arm64 ;; *) echo "unsupported architecture: $arch" >&2; exit 1 ;; esac \
  && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" | tar -xz --strip-components=2 -C /usr/local/bin "gh_${GH_VERSION}_linux_${gh_arch}/bin/gh" \
  && npm install --global "@earendil-works/pi-coding-agent@${PI_VERSION}" \
  && git config --system advice.detachedHead false \
  && apt-get clean

ENV HOME=/workspace \
    PI_CODING_AGENT_HOME=/workspace/.pi \
    PATH=/usr/local/bin:$PATH

WORKDIR /workspace
ENTRYPOINT ["pi"]
