#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bun - "$repo/devenv.nix" "$repo/devenv.lock" <<'JS'
const [nixPath, lockPath] = Bun.argv.slice(2);
if (!(await Bun.file(nixPath).exists())) throw new Error("devenv.nix is missing");
let lock;
try { lock = JSON.parse(await Bun.file(lockPath).text()); }
catch (error) { throw new Error(`Invalid devenv.lock: ${error}`); }
if (lock.version !== 7) {
  throw new Error(`devenv.lock must be generated by devenv (version 7), got ${lock.version ?? 0}`);
}
if (!lock.nodes || typeof lock.nodes !== "object" || !lock.nodes[lock.root]) {
  throw new Error("devenv.lock has no root node");
}
const rootInputs = lock.nodes[lock.root].inputs;
if (rootInputs?.nixpkgs !== "nixpkgs" || rootInputs?.["git-hooks"] !== "git-hooks") {
  throw new Error("devenv.lock root does not contain the declared nixpkgs and git-hooks inputs");
}
for (const name of ["nixpkgs", "git-hooks", "gitignore", "flake-compat"]) {
  const node = lock.nodes[name];
  if (!node?.locked?.rev) {
    throw new Error(`devenv.lock input ${name} has no pinned revision`);
  }
}
// devenv v1.8.1's git-hooks integration is compatible with this revision.
// The project lock format does not require a NAR hash for GitHub inputs.
if (lock.nodes["git-hooks"].locked.rev !== "fa466640195d38ec97cf0493d6d6882bc4d14969") {
  throw new Error("devenv.lock git-hooks input is incompatible with devenv v1.8.1");
}
if (lock.nodes.nixpkgs.original?.repo !== "devenv-nixpkgs" ||
    lock.nodes.nixpkgs.original?.ref !== "rolling") {
  throw new Error("devenv.lock nixpkgs input does not match devenv.yaml");
}
console.log(`devenv lock complete: ${Object.keys(lock.nodes).length} locked inputs (version ${lock.version})`);
JS
