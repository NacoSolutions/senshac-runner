#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bun - "$repo/devenv.nix" "$repo/devenv.lock" <<'JS'
const [nixPath, lockPath] = Bun.argv.slice(2);
if (!(await Bun.file(nixPath).exists())) throw new Error("devenv.nix is missing");
let lock;
try { lock = JSON.parse(await Bun.file(lockPath).text()); }
catch (error) { throw new Error(`Invalid devenv.lock: ${error}`); }
if (lock.version !== 7) {
  throw new Error(`devenv.lock must be generated by devenv (version 7), got ${lock.version ?? 0}`);
}
if (!lock.nodes || typeof lock.nodes !== "object" || !lock.nodes[lock.root]) {
  throw new Error("devenv.lock has no root node");
}
const rootInputs = lock.nodes[lock.root].inputs;
if (!rootInputs || typeof rootInputs !== "object" ||
    JSON.stringify(Object.keys(rootInputs).sort()) !== JSON.stringify(["devenv", "nixpkgs"]) ||
    rootInputs.devenv !== "devenv" || rootInputs.nixpkgs !== "nixpkgs" ||
    !lock.nodes.devenv || !lock.nodes.nixpkgs) {
  throw new Error("devenv.lock root must resolve devenv and nixpkgs inputs");
}
for (const name of ["git-hooks", "gitignore"]) {
  if (Object.hasOwn(lock.nodes, name)) {
    throw new Error(`devenv.lock must not contain the ${name} input`);
  }
}
for (const [name, node] of Object.entries(lock.nodes)) {
  if (name === lock.root || node.locked?.type === "path") continue;
  if (!node.locked?.rev || !node.locked.narHash) {
    throw new Error(`devenv.lock input ${name} is missing a locked revision or NAR hash`);
  }
}
const nixpkgs = lock.nodes.nixpkgs;
if (nixpkgs?.locked?.owner !== "NixOS" ||
    nixpkgs.locked.repo !== "nixpkgs" ||
    nixpkgs.original?.owner !== "NixOS" ||
    nixpkgs.original.repo !== "nixpkgs" ||
    nixpkgs.original.ref !== "nixpkgs-unstable") {
  throw new Error("devenv.lock nixpkgs input does not match the NixOS nixpkgs-unstable policy");
}
console.log(`devenv lock complete: ${Object.keys(lock.nodes).length - 1} locked inputs (version ${lock.version})`);
JS
