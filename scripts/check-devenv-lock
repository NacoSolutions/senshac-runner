#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bun - "$repo/devenv.nix" "$repo/devenv.lock" <<'JS'
const [nixPath, lockPath] = Bun.argv.slice(2);
if (!(await Bun.file(nixPath).exists())) throw new Error("devenv.nix is missing");
let lock;
try { lock = JSON.parse(await Bun.file(lockPath).text()); }
catch (error) { throw new Error(`Invalid devenv.lock: ${error}`); }
if (lock.version !== 7) {
  throw new Error(`devenv.lock must be generated by devenv (version 7), got ${lock.version ?? 0}`);
}
if (!lock.nodes || typeof lock.nodes !== "object" || !lock.nodes[lock.root]) {
  throw new Error("devenv.lock has no root node");
}
const rootInputs = lock.nodes[lock.root].inputs;
if (!rootInputs || typeof rootInputs !== "object" ||
    JSON.stringify(Object.keys(rootInputs).sort()) !== JSON.stringify(["nixpkgs"]) ||
    rootInputs.nixpkgs !== "nixpkgs") {
  throw new Error("devenv.lock root does not match the declared nixpkgs input");
}
const nixpkgs = lock.nodes.nixpkgs;
if (!nixpkgs?.locked?.rev || !nixpkgs.locked.narHash ||
    nixpkgs.original?.repo !== "devenv-nixpkgs" ||
    nixpkgs.original?.ref !== "rolling") {
  throw new Error("devenv.lock nixpkgs input does not match devenv.yaml rolling policy");
}
console.log(`devenv lock complete: ${Object.keys(lock.nodes).length - 1} locked inputs (version ${lock.version})`);
JS
