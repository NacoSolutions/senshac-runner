#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

if ! command -v nix >/dev/null 2>&1; then
  echo "nix is required for OCI flake validation" >&2
  exit 2
fi

nix --extra-experimental-features 'nix-command flakes' flake check --no-write-lock-file
nix --extra-experimental-features 'nix-command flakes' eval --raw .#packages.x86_64-linux.ciTools.name | grep -Fx senshac-ci-tools
nix --extra-experimental-features 'nix-command flakes' eval --raw .#packages.x86_64-linux.ociImage.name | grep -Fx senshac-runner-oci
metadata_link="$(mktemp -u)"
trap 'rm -f "$metadata_link"' EXIT
nix --extra-experimental-features 'nix-command flakes' build --no-write-lock-file --out-link "$metadata_link" .#checks.x86_64-linux.oci-closure-metadata
metadata="$(<"$metadata_link/metadata")"
grep -Fqx 'base_image=none' <<<"$metadata"
grep -F 'selected_tools=' <<<"$metadata" >/dev/null
grep -Fqx 'image=senshac-runner-oci:modular' <<<"$metadata"
printf '%s\n' 'Nix flake and OCI closure metadata validation passed'
