#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

if ! command -v nix >/dev/null 2>&1; then
  echo "nix is required for OCI flake validation" >&2
  exit 2
fi

# Accept the flake configuration so generic Nix installations honor its
# declared inputs and do not write lock updates during validation.
nix_cmd=(nix --accept-flake-config --extra-experimental-features 'nix-command flakes')
"${nix_cmd[@]}" flake check --no-write-lock-file

assert_output() {
  local expected="$1"
  shift
  local actual
  actual="$("${nix_cmd[@]}" "$@" --no-write-lock-file)"
  if [[ "$actual" != "$expected" ]]; then
    printf 'Unexpected output for %q: %s (expected %s)\n' "$1" "$actual" "$expected" >&2
    exit 1
  fi
}

assert_output senshac-runner-runtime eval --raw .#packages.x86_64-linux.runtime.name
for output in runtime ociImage; do
  closure="$("${nix_cmd[@]}" path-info --recursive ".#$output" --no-write-lock-file)"
  if grep -Eiq '/nix/store/[^[:space:]]*(devenv|flox)' <<< "$closure"; then
    printf 'Developer environment or Flox package leaked into .#%s closure\n' "$output" >&2
    grep -Ei '/nix/store/[^[:space:]]*(devenv|flox)' <<< "$closure" >&2
    exit 1
  fi
done
# buildLayeredImage emits a Docker-compatible archive named after the image.
# Keep this exact assertion so the output contract cannot silently drift.
assert_output senshac-runner-oci.tar.gz eval --raw .#packages.x86_64-linux.ociImage.name

# Build the sole public image producer at a caller-supplied link so the
# workflow can upload this exact build instead of rebuilding it later.
oci_link="${OCI_ARCHIVE_OUTPUT:-$repo/.oci-image-check}"
rm -f "$oci_link"
"${nix_cmd[@]}" build --no-write-lock-file --out-link "$oci_link" .#ociImage

metadata_dir="$(mktemp -d)"
trap 'rm -rf "$metadata_dir"' EXIT
"${nix_cmd[@]}" build --no-write-lock-file --out-link "$metadata_dir/result" .#checks.x86_64-linux.oci-closure-metadata
metadata_file="$metadata_dir/result/metadata"
declare -A metadata=()
while IFS='=' read -r key value; do
  [[ -n "$key" ]] || continue
  metadata["$key"]="$value"
done < "$metadata_file"

assert_metadata() {
  local key="$1"
  local expected="$2"
  if [[ "${metadata[$key]-}" != "$expected" ]]; then
    printf 'Unexpected metadata %s: %s (expected %s)\n' "$key" "${metadata[$key]-}" "$expected" >&2
    exit 1
  fi
}

assert_metadata image 'senshac-runner-oci:modular'
assert_metadata base_image none
assert_metadata runtime_tools 'bash bun cacert chromium coreutils curl findutils gcc git gh gnutar gnugrep gzip jq nodejs unzip'
assert_metadata runtime_user 'runner:1000:1000'
assert_metadata writable_paths '/home/runner /tmp /workspace'
assert_metadata runtime_contract 'direct-packaged-runtime'
assert_metadata glibc_abi_loader '/lib64/ld-linux-x86-64.so.2'
assert_metadata image_builder 'dockerTools.buildLayeredImage'
[[ -n "${metadata[runtime]-}" ]] || { echo 'runtime metadata is empty' >&2; exit 1; }
[[ -n "${metadata[image_tarball]-}" ]] || { echo 'image_tarball metadata is empty' >&2; exit 1; }
printf '%s\n' 'Nix flake, OCI build, and closure metadata validation passed'
