#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == --probe-failure ]]; then
  echo SENSHAC_NIX_SMOKE_PROBE_EXECUTED
  exit 42
fi

for tool in bash tar gzip git gh bun node curl jq unzip; do
  command -v "$tool" >/dev/null
 done

bash --version >/dev/null
git --version
gh --version
bun --version
node --version
curl --version | head -1
jq --version
unzip -v | head -1
gzip --version | head -1

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/source" "$tmp/extracted"
printf 'nix runner archive check\n' > "$tmp/source/probe"
tar -czf "$tmp/probe.tar.gz" -C "$tmp" source
test -s "$tmp/probe.tar.gz"
tar -xzf "$tmp/probe.tar.gz" --strip-components=1 -C "$tmp/extracted"
test "$(cat "$tmp/extracted/probe")" = 'nix runner archive check'

curl --fail --silent --show-error --location --max-time 20 https://github.com >/dev/null
node --input-type=commonjs <<'NODE'
const request = require("https").get("https://github.com", response => {
  if (response.statusCode < 200 || response.statusCode >= 400) process.exit(1);
  response.resume();
}).on("error", () => process.exit(1));
request.setTimeout(20000, () => request.destroy(new Error("TLS probe timed out")));
NODE
bun --eval 'const response = await fetch("https://github.com", {signal: AbortSignal.timeout(20000)}); if (!response.ok) process.exit(1);'

echo SENSHAC_NIX_RUNNER_SMOKE_OK
