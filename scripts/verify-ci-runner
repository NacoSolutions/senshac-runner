#!/usr/bin/env bash
set -eu

if [ "${1:-}" = --probe-failure ]; then
  echo SENSHAC_SMOKE_PROBE_EXECUTED
  exit 42
fi

printf 'FLOX_ENV=%s\n' "${FLOX_ENV:-}"
printf 'PATH=%s\n' "$PATH"

test -n "${FLOX_ENV:-}"
test -d "$FLOX_ENV/bin"
case ":$PATH:" in
  *":$FLOX_ENV/bin:"*) ;;
  *) echo 'Activated Flox bin directory missing from PATH' >&2; exit 1 ;;
esac
for tool in tar gzip git gh sd ml tr tl bun node gcc unzip chromium; do
  command -v "$tool"
done
tar_path="$(command -v tar)"
test -x "$tar_path"
"$tar_path" --version
"$tar_path" --version | grep -q 'GNU tar'
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/source" "$tmp/extracted"
printf 'runner archive check\n' > "$tmp/source/probe"
tar -czf "$tmp/probe.tar.gz" -C "$tmp" source
tar -xzf "$tmp/probe.tar.gz" --strip-components=1 -C "$tmp/extracted"
test "$(cat "$tmp/extracted/probe")" = 'runner archive check'
git --version
gh --version
sd --help >/dev/null
ml --help >/dev/null
tr --help >/dev/null
tl --help >/dev/null
printf 'Checking Node and Bun TLS access\n'
node --input-type=commonjs <<'NODE'
const request = require("https").get("https://github.com", response => {
  if (response.statusCode < 200 || response.statusCode >= 400) process.exit(1);
  response.resume();
}).on("error", () => process.exit(1));
request.setTimeout(20000, () => request.destroy(new Error("TLS probe timed out")));
NODE

bun --eval 'const response = await fetch("https://github.com", {signal: AbortSignal.timeout(20000)}); if (!response.ok) process.exit(1);'
printf 'Checking headless Chromium\n'
chromium --headless --no-sandbox --disable-gpu --dump-dom 'data:text/html,<title>senshac-runner</title>' \
  2>/dev/null | grep -q '<title>senshac-runner</title>'
echo SENSHAC_RUNNER_SMOKE_OK
