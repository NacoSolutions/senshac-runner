#!/usr/bin/env bash
set -euo pipefail

runtime="${CONTAINER_RUNTIME:-docker}"
archive="${1:?usage: $0 NIX_ARCHIVE NIX_IMAGE}"
image="${2:?usage: $0 NIX_ARCHIVE NIX_IMAGE}"

archive_bytes="$(wc -c < "$archive")"
runtime_bytes="$($runtime image inspect --format '{{.Size}}' "$image")"

summary=$(cat <<EOF
## CI runner image measurements

The archive and loaded image below are the exact outputs of the canonical
Nix flake `pkgs.dockerTools` build. They are different representations and are
not interchangeable.

| Representation | Bytes |
| --- | ---: |
| Nix dockerTools archive | $archive_bytes |
| Loaded runtime image | $runtime_bytes |
EOF
)
printf '%s\n' "$summary"
if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  printf '%s\n' "$summary" >> "$GITHUB_STEP_SUMMARY"
fi
