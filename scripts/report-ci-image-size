#!/usr/bin/env bash
set -u -o pipefail

# Report measurements without turning an optional measurement into a build
# failure. Build and smoke commands remain responsible for failing CI.
runtime="${CONTAINER_RUNTIME:-docker}"
archive="${1:?usage: $0 NIX_ARCHIVE FLOX_IMAGE}"
flox_image="${2:?usage: $0 NIX_ARCHIVE FLOX_IMAGE MINIMAL_FLOX_IMAGE}"
minimal_flox_image="${3:?usage: $0 NIX_ARCHIVE FLOX_IMAGE MINIMAL_FLOX_IMAGE}"
# The overlay is runtime-mounted, so its image contribution is the base
# archive itself. Set this to a separately built overlay archive when one is
# available; the report keeps the distinction explicit.
# A runtime-mounted overlay has no image archive. Accept a fourth argument only
# when a separately built overlay artifact exists; never count the base twice.
flox_overlay_archive="${4:-unavailable}"

bytes() {
  awk '{print $1}'
}

ratio() {
  local value="$1"
  local baseline="$2"
  if [[ "$value" =~ ^[0-9]+$ && "$baseline" =~ ^[0-9]+$ && "$baseline" -gt 0 ]]; then
    awk -v value="$value" -v baseline="$baseline" 'BEGIN { printf "%.2fx", value / baseline }'
  else
    printf 'unavailable'
  fi
}

minimal_flox_runtime_bytes="unavailable"
if minimal_flox_runtime_bytes="$($runtime image inspect --format '{{.Size}}' "$minimal_flox_image" 2>/dev/null)" && [[ "$minimal_flox_runtime_bytes" =~ ^[0-9]+$ ]]; then
  :
else
  minimal_flox_runtime_bytes="unavailable"
fi

flox_runtime_bytes="unavailable"
if flox_runtime_bytes="$($runtime image inspect --format '{{.Size}}' "$flox_image" 2>/dev/null)" && [[ "$flox_runtime_bytes" =~ ^[0-9]+$ ]]; then
  :
else
  flox_runtime_bytes="unavailable"
fi

minimal_flox_compressed_bytes="unavailable"
if minimal_flox_compressed_bytes="$($runtime save "$minimal_flox_image" 2>/dev/null | gzip -c | wc -c | bytes)" && [[ "$minimal_flox_compressed_bytes" =~ ^[0-9]+$ ]]; then
  :
else
  minimal_flox_compressed_bytes="unavailable"
fi

flox_compressed_bytes="unavailable"
if flox_compressed_bytes="$($runtime save "$flox_image" 2>/dev/null | gzip -c | wc -c | bytes)" && [[ "$flox_compressed_bytes" =~ ^[0-9]+$ ]]; then
  :
else
  flox_compressed_bytes="unavailable"
fi

nix_archive_bytes="unavailable"
if nix_archive_bytes="$(wc -c < "$archive" 2>/dev/null)" && [[ "$nix_archive_bytes" =~ ^[0-9]+$ ]]; then
  :
fi

nix_flox_overlay_bytes="unavailable"
if [[ "$flox_overlay_archive" != unavailable ]] && nix_flox_overlay_bytes="$(wc -c < "$flox_overlay_archive" 2>/dev/null)" && [[ "$nix_flox_overlay_bytes" =~ ^[0-9]+$ ]]; then
  :
fi

loaded_nix_runtime_bytes="unavailable"
if "$runtime" load < "$archive" >/dev/null 2>&1; then
  loaded_nix_runtime_bytes="$($runtime image inspect --format '{{.Size}}' senshac-runner-oci:modular 2>/dev/null || true)"
  [[ "$loaded_nix_runtime_bytes" =~ ^[0-9]+$ ]] || loaded_nix_runtime_bytes="unavailable"
fi

nix_archive_ratio="$(ratio "$nix_archive_bytes" "$nix_archive_bytes")"
nix_overlay_archive_ratio="$(ratio "$nix_flox_overlay_bytes" "$nix_archive_bytes")"
minimal_flox_archive_ratio="$(ratio "$minimal_flox_compressed_bytes" "$nix_archive_bytes")"
flox_archive_ratio="$(ratio "$flox_compressed_bytes" "$nix_archive_bytes")"
minimal_flox_runtime_ratio="$(ratio "$minimal_flox_runtime_bytes" "$loaded_nix_runtime_bytes")"
nix_runtime_ratio="$(ratio "$loaded_nix_runtime_bytes" "$loaded_nix_runtime_bytes")"
nix_overlay_runtime_ratio="$(ratio "$loaded_nix_runtime_bytes" "$loaded_nix_runtime_bytes")"
flox_runtime_ratio="$(ratio "$flox_runtime_bytes" "$loaded_nix_runtime_bytes")"

summary=$(cat <<EOF
## CI runner image measurements

These measurements come from the same CI run. Ratios are each value divided
by the Nix base (the first available Nix-base value in its column); they are
reported observations, not targets.

### Archive size (compressed/transport representation)

| Variant | Bytes | Ratio to Nix base |
| --- | ---: | ---: |
| Nix base/minimal profile | $nix_archive_bytes | $nix_archive_ratio |
| Nix base + runtime Flox overlay | $nix_flox_overlay_bytes | $nix_overlay_archive_ratio |
| Minimal Flox environment (same CI contract) | $minimal_flox_compressed_bytes | $minimal_flox_archive_ratio |
| Legacy/full Flox baseline | $flox_compressed_bytes | $flox_archive_ratio |

### Loaded runtime size (container engine image-inspect Size)

| Variant | Bytes | Ratio to Nix base |
| --- | ---: | ---: |
| Nix base/minimal profile | $loaded_nix_runtime_bytes | $nix_runtime_ratio |
| Nix base + runtime Flox overlay (image layers only) | $loaded_nix_runtime_bytes | $nix_overlay_runtime_ratio |
| Minimal Flox environment (same CI contract) | $minimal_flox_runtime_bytes | $minimal_flox_runtime_ratio |
| Legacy/full Flox baseline | $flox_runtime_bytes | $flox_runtime_ratio |

The runtime Flox overlay is mounted from the checkout and is deliberately not
copied into the Nix archive. Its archive and loaded-image rows therefore report
the Nix base image only; the mounted profile's filesystem/cache footprint is
not measured by the container image engine. A minimal Flox variant is reported
from the separately locked `.flox/ci` manifest; the full locked Flox
environment remains the developer baseline.

Archive bytes are file/stream bytes and loaded bytes are the engine's
unpacked/virtual image size; the two columns are not interchangeable. Nix
builds may use configured binary caches or realize nixpkgs locally on a cache
miss. Flox may use its configured package/cache sources during containerize.
The minimal profile performs no package-manager or network bootstrap; the
runtime overlay requires a pinned lock and a supplied Flox binary, while the
smoke/network probes require network access. No registry pull is used for the
Nix archive measurement; the legacy baseline uses the locally built image.
EOF
)
printf '%s\n' "$summary"
if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  printf '%s\n' "$summary" >> "$GITHUB_STEP_SUMMARY"
fi
