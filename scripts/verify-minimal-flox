#!/usr/bin/env bash
set -euo pipefail
runtime="${CONTAINER_RUNTIME:-docker}"
image="${1:?Usage: scripts/verify-minimal-flox IMAGE}"
"$runtime" run --rm --pull=never "$image" sh -c '
  set -eu
  fail() {
    printf "MINIMAL_FLOX_CHECK_FAILED: %s\n" "$1" >&2
    exit 1
  }
  for tool in bash bun curl find gh git grep tar gzip jq node unzip; do
    path="$(command -v "$tool" 2>/dev/null || true)"
    [ -n "$path" ] || fail "missing command: $tool"
    printf "MINIMAL_FLOX_COMMAND: %s=%s\n" "$tool" "$path"
  done
  cert="${SSL_CERT_FILE:-}"
  [ -n "$cert" ] || fail "SSL_CERT_FILE is unset"
  [ -s "$cert" ] || fail "SSL_CERT_FILE is not a non-empty file: $cert"
  printf "MINIMAL_FLOX_CERT: %s\n" "$cert"
  printf "%s\n" MINIMAL_FLOX_OK
'
