#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="${CONTAINER_RUNTIME:-podman}"
image="${1:?Usage: scripts/smoke-ci-runner IMAGE}"
log="$(mktemp)"
trap 'rm -f "$log"' EXIT

# File arguments survive direct execution by the packaged image shell.
run=("$runtime" run --rm --pull=never -e QUIET=1
  --volume "$repo:/workspace:ro"
  --volume "$repo/scripts:/runner-check:ro")
if [[ "$(basename "$runtime")" == podman ]]; then
  run+=(--userns=keep-id:uid=1000,gid=1000)
fi

printf 'Checking smoke execution and failure propagation: %s\n' "$image"
status=0
"${run[@]}" "$image" bash /runner-check/verify-ci-runner --probe-failure >"$log" 2>&1 || status=$?
cat "$log"
if [[ "$status" != 42 ]] || ! grep -qx 'SENSHAC_SMOKE_PROBE_EXECUTED' "$log"; then
  echo "Smoke failure probe expected marker and exit 42; received exit $status" >&2
  exit 1
fi

printf 'Running directly packaged runner checks: %s\n' "$image"
"${run[@]}" "$image" bash /runner-check/verify-ci-runner | tee "$log"
grep -qx 'SENSHAC_RUNNER_SMOKE_OK' "$log" || {
  echo 'Smoke script completion marker missing' >&2
  exit 1
}
