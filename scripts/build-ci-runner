#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
runtime="${CONTAINER_RUNTIME:-podman}"
target="${1:-senshac-ci-runner:latest}"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing prerequisite: $1" >&2
    exit 2
  }
}

require nix
require "$runtime"

# Flox remains the package contract and is checked before Nix assembles the
# immutable OCI closure. The image itself is deliberately produced only by
# dockerTools; it never invokes the Flox container builder or apt-get.
if [[ "${SKIP_FLOX_LOCK_CHECK:-0}" != 1 ]]; then
  "$repo/scripts/check-flox-lock"
fi

nix_cmd=(nix --extra-experimental-features 'nix-command flakes')
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
archive="$tmp/senshac-runner-oci.tar.gz"

printf 'Building Nix dockerTools OCI image: %s\n' "$target"
"${nix_cmd[@]}" build --no-write-lock-file --out-link "$archive" "$repo#ociImage"

printf 'Loading immutable OCI archive with %s\n' "$runtime"
"$runtime" load --input "$archive"
source="senshac-runner-oci:modular"
"$runtime" image inspect "$source" >/dev/null
"$runtime" tag "$source" "$target"
printf 'Published local image %s from %s\n' "$target" "$source"
