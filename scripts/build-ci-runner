#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
runtime="${CONTAINER_RUNTIME:-podman}"
target="${1:-senshac-ci-runner:latest}"

# Keep Flox's generated entrypoint: it activates the environment before
# dispatching commands, so the published image and local image have the same
# runtime contract.
exec flox containerize -d "$repo" --runtime "$runtime" --tag "$target"
