#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
runtime="${CONTAINER_RUNTIME:-podman}"
target="${1:-senshac-ci-runner:latest}"
local_tag="senshac-ci-runner:local"

# Flox currently accepts only a simple local tag here. Keep its generated
# image and entrypoint unchanged, then use the selected runtime for the full
# registry target.
flox containerize -d "$repo" --runtime "$runtime" --tag "$local_tag"
"$runtime" tag "$local_tag" "$target"
