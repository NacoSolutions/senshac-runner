#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 - "$repo/.flox/env/manifest.toml" "$repo/.flox/env/manifest.lock" <<'PY'
import json
import sys
import tomllib

with open(sys.argv[1], "rb") as source:
    manifest = tomllib.load(source)
with open(sys.argv[2]) as source:
    lock = json.load(source)
if lock["manifest"] != manifest:
    sys.exit("Flox lock manifest differs from manifest.toml; reconcile using Flox CLI")

packages = {(p["install_id"], p["system"]): p for p in lock["packages"]}
errors = []
for name, spec in manifest["install"].items():
    for system in spec.get("systems", manifest["options"]["systems"]):
        package = packages.get((name, system))
        if not package or not package.get("outputs"):
            errors.append(f"{name}/{system}: missing resolved package outputs")
if errors:
    sys.exit("Incomplete Flox lock:\n" + "\n".join(errors))
print(f"Flox lock complete: {len(packages)} resolved package/system entries")
PY
