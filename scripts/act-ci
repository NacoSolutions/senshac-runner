#!/usr/bin/env bash
set -euo pipefail

socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"

target_repo="${SENSHAC_WEB_REPO:-${1:-}}"
if [[ -z "$target_repo" ]]; then
  echo "Usage: SENSHAC_WEB_REPO=/path/to/senshac [args...] $0" >&2
  exit 2
fi
target_repo="$(realpath "$target_repo")"
if [[ ! -d "$target_repo/.git" ]]; then
  echo "Target repository is not a Git worktree or wrapper: $target_repo" >&2
  exit 1
fi

if [[ ! -S "$socket" ]]; then
  systemctl --user start podman.socket
fi

export DOCKER_HOST="unix://${socket}"

common_dir="$(git -C "$target_repo" rev-parse --path-format=absolute --git-common-dir)"
head="$(git -C "$target_repo" rev-parse HEAD)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git clone --no-hardlinks "$common_dir" "$tmp/repo" >/dev/null
git -C "$tmp/repo" checkout --detach "$head" >/dev/null
cd "$tmp/repo"

act pull_request \
  --workflows .github/workflows/ci.yml \
  --job ci \
  --platform ubuntu-latest=ghcr.io/nacosolutions/senshac-ci-runner:latest \
  --container-daemon-socket - \
  --container-architecture linux/amd64 \
  --pull=false \
  "$@"
