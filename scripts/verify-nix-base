#!/usr/bin/env bash
set -euo pipefail

runtime="${CONTAINER_RUNTIME:-docker}"
image="${1:?Usage: scripts/verify-nix-base IMAGE}"
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# devenv writes both .devenv and .devenv.flake.nix below its project root.
# Verify an isolated copy so the checkout stays unchanged while the mounted
# workspace remains writable for the complete devenv evaluation.
verification_workspace="$(mktemp -d "${TMPDIR:-/tmp}/senshac-verify.XXXXXX")"
cleanup() {
  rm -rf -- "$verification_workspace"
}
trap cleanup EXIT

prepare_verification_workspace() {
  tar -C "$repo" \
    --exclude='./.devenv' \
    --exclude='./.devenv.flake.nix' \
    -cf - . | tar -C "$verification_workspace" -xf -
}
prepare_verification_workspace

# Every non-base tool comes from the mounted project's committed devenv lock.
# The writable copy is temporary and is removed by cleanup after verification.
run_image() {
  "$runtime" run --rm --pull=never \
    --entrypoint /usr/bin/env \
    --volume "$verification_workspace:/workspace:rw" \
    -e DEVENV_ROOT=/workspace \
    "$image" "$@"
}

# Fail with the missing runtime path rather than an opaque activation error.
# The dockerTools image has no base distribution. devenv shell activation uses the
# conventional absolute shell path as well as env-based shebangs, so verify
# both runtime paths before attempting activation.
printf 'Checking image runtime contract: /usr/bin/env and /usr/bin/bash\n'
run_image bash -c 'test -x /usr/bin/env && test -x /usr/bin/bash && command -v bash'

run_devenv() {
  "$runtime" run --rm --pull=never \
    --volume "$verification_workspace:/workspace:rw" \
    -e DEVENV_ROOT=/workspace \
    "$image" devenv shell -- "$@"
}

printf 'Checking mounted devenv environment: %s\n' "$image"
run_devenv command -v bun
run_devenv command -v chromium
run_devenv chromium --headless --no-sandbox --disable-gpu \
  --dump-dom 'data:text/html,<title>senshac-runner</title>' \
  2>/dev/null | grep -q '<title>senshac-runner</title>'
printf '%s\n' NIX_DEVENV_MOUNTED_PROJECT_OK
