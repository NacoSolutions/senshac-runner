#!/usr/bin/env bash
set -euo pipefail

runtime="${CONTAINER_RUNTIME:-docker}"
image="${1:?Usage: scripts/verify-nix-base IMAGE}"
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

verification_workspace="$(mktemp -d "${TMPDIR:-/tmp}/senshac-verify.XXXXXX")"
cleanup() {
  rm -rf -- "$verification_workspace"
}
trap cleanup EXIT

# Verify the committed checkout in a writable, isolated bind mount. The image
# remains the direct Nix runtime; no activation files or lock are generated.
archive="$(mktemp "${TMPDIR:-/tmp}/senshac-source.XXXXXX.tar")"
git -C "$repo" archive --format=tar HEAD > "$archive"
tar -C "$verification_workspace" -xf "$archive"
rm -f -- "$archive"

runner_uid="$(id -u)"
runner_gid="$(id -g)"
container_args=(run --rm --pull=never)
if [[ "$(basename "$runtime")" == podman ]]; then
  # Require a genuinely rootless host runtime and map the image user onto the
  # invoking host user for the writable workspace bind mount.
  [[ "$runner_uid" -ne 0 ]] || { echo 'Rootless Podman verification requires a non-root host user' >&2; exit 2; }
  podman_rootless="$("$runtime" info --format '{{.Host.Security.Rootless}}')"
  [[ "$podman_rootless" == true ]] || { echo 'Podman is not running rootless' >&2; exit 2; }
  container_args+=(--userns=keep-id:uid=1000,gid=1000 -e EXPECT_RUNNER_USER=1)
else
  # Docker's rootful daemon does not need a user namespace mapping.
  container_args+=(--user "$runner_uid:$runner_gid")
  mkdir -m 700 -- "$verification_workspace/.home"
  container_args+=(--volume "$verification_workspace/.home:/home/runner:rw")
fi
container_args+=(
  --volume "$verification_workspace:/workspace:rw"
  --workdir /workspace
  -e HOME=/home/runner
  -e TMPDIR=/tmp
)

printf 'Checking direct runtime tools and non-root filesystem contract: %s\n' "$image"
"$runtime" "${container_args[@]}" "$image" bash -eu -c '
  uid="$(id -u)"
  test "$uid" -gt 0
  test "$HOME" = /home/runner
  test -w "$HOME"
  test -d /tmp && test -w /tmp
  test "$(stat -c %a /tmp)" = 1777
  test -w /workspace
  if [ "${EXPECT_RUNNER_USER:-0}" = 1 ]; then
    test "$uid" = 1000
    test "$(id -un)" = runner
  fi
  for tool in bash tar gzip git gh bun node gcc unzip chromium jq curl; do
    command -v "$tool"
  done
  home_probe="$(mktemp "$HOME/.oci-home.XXXXXX")"
  tmp_probe="$(mktemp /tmp/.oci-tmp.XXXXXX)"
  workspace_probe="$(mktemp /workspace/.oci-workspace.XXXXXX)"
  rm -f -- "$home_probe" "$tmp_probe" "$workspace_probe"
  printf "runtime uid=%s home=%s workspace=%s\\n" "$uid" "$HOME" "$PWD"
'
