#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="${CONTAINER_RUNTIME:-podman}"
image="${1:?Usage: scripts/smoke-nix-ci-runner IMAGE}"
log="$(mktemp)"
trap 'rm -f "$log"' EXIT

run=("$runtime" run --rm --pull=never
  --volume "$repo/scripts:/runner-check:ro"
  "$image" sh /runner-check/verify-nix-ci-runner)

printf 'Checking Nix canary execution and failure propagation: %s\n' "$image"
status=0
"${run[@]}" --probe-failure >"$log" 2>&1 || status=$?
cat "$log"
if [[ "$status" != 42 ]] || ! grep -qx 'SENSHAC_NIX_SMOKE_PROBE_EXECUTED' "$log"; then
  echo "Nix smoke failure probe expected marker and exit 42; received exit $status" >&2
  exit 1
fi

printf 'Running minimal Nix runner checks: %s\n' "$image"
"${run[@]}" | tee "$log"
grep -qx 'SENSHAC_NIX_RUNNER_SMOKE_OK' "$log" || {
  echo 'Nix smoke script completion marker missing' >&2
  exit 1
}
